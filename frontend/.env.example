# Backend base URL (no trailing slash). Restart `npm run dev` after editing.
VITE_API_URL=http://localhost:8000/api
# Seconds between kiosk event refreshes
VITE_KIOSK_POLL_SECONDS=30
# Seconds each event stays on the carousel before moving to the next
VITE_CAROUSEL_SECONDS=8
# Seconds a guest can undo their own check-in (keep below the server's undo_grace_seconds)
VITE_UNDO_SECONDS=5
# Club logo shown on the kiosk. Put your file in /public and change the name (png, svg or webp).
VITE_LOGO_URL=/logo.svg
# Seconds each promotion stays on screen
VITE_PROMO_SECONDS=10
